generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
  DEVELOPER
}

enum QueryStatus {
  SUCCESS
  NO_CONTEXT_FOUND
  BLOCKED_INJECTION
  BLOCKED_OUT_OF_SCOPE
  ERROR
}

enum LogLevel {
  INFO
  WARN
  ERROR
  CRITICAL
}

model User {
  id            String     @id @default(cuid())
  username      String     @unique
  email         String?    @unique
  name          String?
  passwordHash  String?    // Null for Google OAuth-only users
  image         String?
  role          Role       @default(USER)
  provider      String     @default("credentials") // "credentials" | "google"
  isBlocked     Boolean    @default(false)
  blockedAt     DateTime?
  blockedReason String?
  createdAt     DateTime   @default(now())
  lastActiveAt  DateTime   @default(now())

  documents     Document[]
  messages      Message[]
  usageLogs     UsageLog[]
}

model Document {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename      String
  mimeType      String
  sizeBytes     Int
  extractedText String   @db.Text
  tokenCount    Int
  isSelected    Boolean  @default(true) // Toggled in right-side Sources panel
  createdAt     DateTime @default(now())

  @@index([userId])
}

model Message {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   // "user" | "assistant" | "system_alert"
  content   String   @db.Text
  citations Json?    // Array of { documentId, filename, snippet }
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model UsageLog {
  id               String      @id @default(cuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  model            String      // e.g., "gpt-4o-mini"
  promptTokens     Int         @default(0)
  cachedTokens     Int         @default(0)
  completionTokens Int         @default(0)
  totalTokens      Int         @default(0)
  estimatedCostUsd Float       @default(0)
  latencyMs        Int         @default(0)
  status           QueryStatus @default(SUCCESS)
  guardrailReason  String?     // Rule / reason populated if blocked
  flaggedText      String?     @db.Text // ONLY populated for texts flagged as dangerous (BLOCKED_INJECTION)
  hourOfDay        Int         // 0-23 (UTC or configured TZ) for fast peak-time aggregation
  dayOfWeek        Int         // 0-6 (Sun-Sat)
  createdAt        DateTime    @default(now())

  @@index([userId])
  @@index([hourOfDay])
  @@index([createdAt])
}

model SystemLog {
  id        String   @id @default(cuid())
  level     LogLevel @default(INFO)
  source    String   // e.g. "fileParser.pdf", "api.documents", "api.chat", "api.studio", "developer.repair"
  message   String   @db.Text
  stack     String?  @db.Text
  meta      Json?    // Additional context (error codes, latency, file extension, etc.)
  userId    String?
  username  String?
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([level])
  @@index([source])
  @@index([createdAt])
}
