# Local PostgreSQL (no ?sslmode=require needed for local Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/contextlm"

# Auth.js v5 session encryption secret (at least 32 characters)
AUTH_SECRET="contextlm-local-dev-secret-change-in-production-2026"
AUTH_URL="http://localhost:3000"

# OpenAI API key & models (use models enabled on your OpenAI account, e.g. gpt-4o-mini)
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_PRIMARY_MODEL="gpt-4o-mini"
OPENAI_GUARDRAIL_MODEL="gpt-4o-mini"

# Optional Google OAuth (leave empty for username/password login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: Set both to "true" to run with in-memory Mock DB & Mock AI (no Postgres/OpenAI required)
DEMO_MOCK_MODE="false"
NEXT_PUBLIC_DEMO_MOCK_MODE="false"
