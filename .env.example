# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Auth.js v5 session encryption secret (at least 32 characters)
AUTH_SECRET="contextlm-local-dev-secret-change-in-production-2026"
AUTH_URL="http://localhost:3000"

# OpenAI API key & models (e.g. gpt-4o-mini)
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_PRIMARY_MODEL="gpt-4o-mini"
OPENAI_GUARDRAIL_MODEL="gpt-4o-mini"

# Optional Google OAuth (leave empty for username/password login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
